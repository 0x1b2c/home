# This file is in a public repo. Host names, addresses and ports live in
# ~/.ssh/config.local, which the Include below pulls in.
#
# ssh keeps the first value it finds for each keyword, so every Include has to
# come before the Host * block or these generic values would win instead.
#
# A missing Include target is skipped silently, so a fresh clone works with no
# local file present.

# UseKeychain is macOS only, and an unknown keyword is fatal to ssh, not
# ignored. This keeps the same file usable on Linux.
IgnoreUnknown UseKeychain

Include ~/.orbstack/ssh/config
Include ~/.ssh/config.local

Host *
    UseKeychain yes
    AddKeysToAgent yes

    # Reuse one connection for every later ssh, scp and git to the same host,
    # which saves a full TCP and auth handshake each time.
    ControlMaster auto
    ControlPath ~/.ssh/socket-%r@%h:%p
    ControlPersist yes

    AddressFamily inet
    Compression yes
    ForwardX11 no
    TCPKeepAlive yes
    ServerAliveInterval 60
    ServerAliveCountMax 120
