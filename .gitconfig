# ── Identity ────────────────────────────────────────────────────────────────
[user]
	email = interface@1b2c.org
	name = 1b2c
	signingKey = 876DF69CF7BD9DA6807FF56C0B10A078285066FD
[includeIf "gitdir:~/work/"]
	path = ~/work/.gitconfig   # Separate config (name/email) for work repos
[github]
	user = 0x1b2c
[credential]
	helper = osxkeychain
[commit]
	gpgsign = true

# ── Core ────────────────────────────────────────────────────────────────────
[core]
	; eol = lf
	autocrlf = input      # Convert CRLF→LF on commit, keep LF on checkout
	safecrlf = warn
	quotepath = off        # Show non-ASCII filenames as-is (e.g. CJK)
	pager = delta          # Use delta for all paged output (diff, log, show, etc.)
	fsync = none
[init]
	defaultBranch = master
[submodule]
	recurse = true

# ── Pager and colour ────────────────────────────────────────────────────────
[color]
	ui = true
[color "diff"]
	meta = 11
	frag = magenta bold
	commit = yellow bold
	old = "#ff5555"
	new = "#50fa7b"
	whitespace = red reverse
[pager]
	difftool = true
[interactive]
	diffFilter = delta --color-only  # Delta rendering for `git add -p`
[delta]
	navigate = true    # use n and N to move between diff sections
	tabs = 2
	; side-by-side = true
	line-numbers = true
	# Map git's colorMoved output to distinct delta styles
	# so swapped/moved lines are visually different from plain add/remove
	map-styles = "bold purple => syntax #330033, bold cyan => syntax #003333"

# ── Diff and merge ──────────────────────────────────────────────────────────
[diff]
	colorMoved = default       # Highlight moved lines in diff (purple=source, cyan=destination)
	renames = copies           # Detect renames and copies
	; tool	= difftastic disabled due to delta
[difftool]
	prompt = false
[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"
[merge]
	summary = true
	tool	= gvimdiff

# ── Branch, push, rebase ────────────────────────────────────────────────────
[branch]
	autosetuprebase = always  # New tracking branches default to rebase on pull
[pull]
	rebase = true
[push]
	default = simple
	autoSetupRemote = true     # `git push` auto-creates remote tracking branch
	followTags = true          # Push annotated tags that point to pushed commits
[rebase]
	updateRefs = true
	instructionFormat = %as %an %s   # Show author date in the interactive todo list
[rerere]
	enabled = true             # Remember conflict resolutions for reuse

# ── Filters and archive formats ─────────────────────────────────────────────
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[tar "tar.xz"]
	command = xz -c

# ── Aliases ─────────────────────────────────────────────────────────────────
[alias]
	# ── Staging ──
	a		= add
	aa		= add .
	ap		= add -p
	au		= add -u

	# ── Archive (zip/tar snapshots of HEAD) ──
	; echo "$(git show -s --format=%cd --date=format:%Y%m%d HEAD)-$(git rev-parse --short HEAD)"
	arc		= !git archive --format=zip --prefix="$(basename $PWD)/" HEAD -o "$(basename $PWD)-`git rev-parse --short HEAD`.zip"
	arctar	= !git archive --format=tar.gz --prefix="$(basename $PWD)/" HEAD -o "$(basename $PWD)-`git rev-parse --short HEAD`.tar.gz"
	arcr	= !git archive --format=zip --prefix="$(basename $PWD)/" HEAD -o "$(basename $PWD)-$(git show -s --format=%cd --date=format:%Y%m%d HEAD)-$(git rev-parse --short HEAD).zip"
	arcnop	= !git archive --format=zip HEAD -o "$(basename $PWD)-`git rev-parse --short HEAD`.ipa"

	# ── Branch / Checkout ──
	amr		= am --resolved
	b		= branch
	cb		= checkout -b
	co		= checkout
	chp		= cherry-pick
	ch		= cherry -v

	# ── Bisect ──
	bs		= bisect
	bss		= bisect start
	bsb		= bisect bad
	bsg		= bisect good
	bsr		= bisect reset

	# ── Commit ──
	# --no-verify Skip pre-commit / commit-msg hooks to avoid local commits being slowed by lint, formatters, etc.
	ci		= commit --gpg-sign --no-verify
	cii		= commit --gpg-sign -m 'Initial commit'
	cia		= !GIT_COMMITTER_DATE="$(git show -s --format=%aI HEAD)" git commit --gpg-sign --no-verify --amend --no-edit
	ciae	= !GIT_COMMITTER_DATE="$(git show -s --format=%aI HEAD)" git commit --gpg-sign --no-verify --amend
	cig		= commit --gpg-sign --no-verify --trailer 'Co-authored-by: Gemini <gemini@google.com>'
	cim		= commit --gpg-sign --no-verify -m

	# ── Diff ──
	# d/dc: default (delta rendered)
	# db/dcb: ignore whitespace (-b) for legacy projects
	# dr/dcr: delta without syntax highlighting
	# dw/dcw: git native word-diff, bypasses delta for compact inline view
	# dm: difftastic (AST-based structural diff)
	d		= diff
	db		= -c core.pager=less diff -b
	dr		= -c delta.features=raw diff
	dw		= diff --word-diff=color
	dc		= diff --cached
	dcb		= -c core.pager=less diff -b --cached
	dcr		= -c delta.features=raw diff --cached
	dcw		= diff --cached --word-diff=color
	dm		= -c diff.external=difft diff
	ds		= diff -b --stat
	dt		= difftool
	dct		= difftool --cached

	# ── HEAD shortcuts (avoid typing HEAD~N) ──
	# git h 3 → show HEAD~3, git h → show HEAD~1
	h		= "!f() { git show HEAD~${1:-1}; }; f"
	# git hd 3 1 → diff HEAD~3..HEAD~1, git hd 3 → diff HEAD~3..HEAD
	hd		= "!f() { git diff HEAD~$1..${2:+HEAD~$2}${2:-HEAD}; }; f"

	# ── Log ──
	l		= log -p
	lg		= log --oneline --decorate --graph
	lgg		= log --color --graph --pretty=format:'%C(yellow)%h%Creset -%C(red)%d%Creset %s %Cgreen(%ch) %C(bold blue)<%an>%Creset' --abbrev-commit
	log		= log --show-signature

	# ── Merge / Rebase ──
	mt		= mergetool -y
	rb		= rebase --gpg-sign
	rbd		= rebase --gpg-sign --committer-date-is-author-date
	rbi		= rebase --gpg-sign -i
	rbid	= rebase --gpg-sign -i --committer-date-is-author-date
	rbc		= rebase --continue
	rba		= rebase --abort

	# ── Push ──
	pusho	= !git push --set-upstream origin $(git branch --show-current)

	# ── Reset ──
	rt		= reset
	rth		= reset --hard
	rthsm	= reset --hard --recurse-submodules

	# ── Status / Show ──
	s		= status
	set		= !git add . && git commit -m 'Initial commit'
	show	= show -b
	showw	= show -b --word-diff=color
	shows	= show --show-signature
	lsu		= ls-files --others --directory

	# ── Submodule ──
	sm		= submodule

	# ── Stash (stp/sts + number for specific stash entries) ──
	st		= stash
	sti		= stash push --keep-index
	stl		= stash list
	stp		= stash pop
	sts		= stash show -p
	stp1	= stash pop stash@{1}
	stp2	= stash pop stash@{2}
	stp3	= stash pop stash@{3}
	stp4	= stash pop stash@{4}
	stp5	= stash pop stash@{5}
	sts1	= stash show stash@{1} -p
	sts2	= stash show stash@{2} -p
	sts3	= stash show stash@{3} -p
	sts4	= stash show stash@{4} -p
	sts5	= stash show stash@{5} -p

	# ── Worktree ──
	ws		= worktree
	wsl		= worktree list
	wsa		= worktree add
	wsr		= worktree remove

	# ── Tag ──
	tagme	= !git tag "v$(git show --no-patch --date=format:%Y%m%d --pretty=format:'%cd-%h' HEAD)"

	# ── Inspection ──
	ps		= log --pretty=oneline origin..master  # Preview what will be pushed
	w		= log --raw --no-merges
	wc		= log --raw --no-merges -p
	today	= "!git log --since=\"12 hours ago\" --author=\"`git config --get user.name`\" --reverse --pretty=format:%s"
	# shr: the commit object as git stores it (tree, parent, author, committer),
	# like `cat-file -p` but with readable dates. --pretty=raw keeps the epoch.
	shr		= "!f() { git show -s --date=format:'%Y-%m-%d %H:%M:%S %z' --format='commit %H%ntree %T%nparent %P%nauthor %an <%ae> %ad%ncommitter %cn <%ce> %cd%n%n%B' \"${1:-HEAD}\"; }; f"

	# ── Open files in editor ──
	edit-modified   = "!f() { git ls-files -m | awk '{print $NF}' | sort -u; }; vimr --cur-env -p `f`"
	edit-unmerged	= "!f() { git ls-files -u | awk '{print $NF}' | sort -u; }; vimr --cur-env -p `f`"
	add-unmerged	= "!f() { git ls-files -u | awk '{print $NF}' | sort -u; }; git add `f`"
